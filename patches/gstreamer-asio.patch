+  gst_asio_object_get_cached_latencies (self->asio_object, &input_latency,
+      &output_latency);
+
+  switch (self->type) {
+    case GST_ASIO_DEVICE_CLASS_RENDER:
+    {
+      auto priv = self->priv;
+      gint64 last_time = priv->last_callback_time.load ();
+      gint rate = GST_AUDIO_INFO_RATE (&buf->spec.info);
+      guint64 queued, elapsed;
+
+      if (last_time == 0 || rate <= 0)
+        return 0;
+
+      /* The ringbuffer advances once a segment is copied into the ASIO
+       * buffer, but the driver still holds that and the previously queued
+       * buffers (at least two, ASIO is double buffered). Subtract what was
+       * played since the last callback, then add the driver's output
+       * latency which doesn't include the buffers */
+      queued = (guint64) MAX (gst_asio_object_get_num_prefill_buffers
+          (self->asio_object), 2) * self->buffer_size;
+      elapsed = gst_util_uint64_scale_int (g_get_monotonic_time () -
+          last_time, rate, G_USEC_PER_SEC);
+      elapsed = MIN (elapsed, (guint64) self->buffer_size);
+
+      return (guint) (queued - elapsed + output_latency);
+    }
+    case GST_ASIO_DEVICE_CLASS_CAPTURE:
+      return (guint) input_latency;
+    default:
+      /* Loopback copies data at the time it's written to the device */
+      return 0;
+  }
 }
 
