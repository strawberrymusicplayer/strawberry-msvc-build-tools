+      obj->cached_input_latency = MAX (in_latency, 0);
+      obj->cached_output_latency = MAX (out_latency, 0);
+    } else {
+      GST_WARNING_OBJECT (obj, "Failed to query latencies");
+      obj->cached_input_latency = 0;
+      obj->cached_output_latency = 0;
