+  g_return_val_if_fail (GST_IS_ASIO_OBJECT (obj), FALSE);
+
+  if (g_atomic_int_compare_and_exchange (&obj->latencies_dirty, 1, 0)) {
+    glong in_latency = 0, out_latency = 0;
