diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt	1970-01-01 01:00:00.000000000 +0100
+++ b/CMakeLists.txt	2026-11-15 01:16:57.806734700 +0100
@@ -0,0 +1,102 @@
+cmake_minimum_required(VERSION 3.16)
+project(libcdio VERSION 2.4.0 LANGUAGES C)
+
+include(GNUInstallDirs)
+
+set(LIBCDIO_VERSION_NUM 20400)
+
+set(VERSION "${PROJECT_VERSION}")
+set(build "Windows")
+configure_file(include/cdio/version.h.in "${CMAKE_CURRENT_BINARY_DIR}/include/cdio/version.h" @ONLY)
+
+set(LIBCDIO_SOURCES
+  lib/driver/_cdio_generic.c
+  lib/driver/_cdio_stdio.c
+  lib/driver/_cdio_stream.c
+  lib/driver/abs_path.c
+  lib/driver/aix.c
+  lib/driver/audio.c
+  lib/driver/cd_types.c
+  lib/driver/cdio.c
+  lib/driver/cdtext.c
+  lib/driver/device.c
+  lib/driver/disc.c
+  lib/driver/ds.c
+  lib/driver/FreeBSD/freebsd.c
+  lib/driver/gnu_linux.c
+  lib/driver/image/bincue.c
+  lib/driver/image/cdrdao.c
+  lib/driver/image/nrg.c
+  lib/driver/image_common.c
+  lib/driver/logging.c
+  lib/driver/memory.c
+  lib/driver/mmc/mmc.c
+  lib/driver/mmc/mmc_hl_cmds.c
+  lib/driver/mmc/mmc_ll_cmds.c
+  lib/driver/mmc/mmc_util.c
+  lib/driver/MSWindows/aspi32.c
+  lib/driver/MSWindows/win32.c
+  lib/driver/MSWindows/win32_ioctl.c
+  lib/driver/netbsd.c
+  lib/driver/osx.c
+  lib/driver/read.c
+  lib/driver/realpath.c
+  lib/driver/sector.c
+  lib/driver/solaris.c
+  lib/driver/track.c
+  lib/driver/utf8.c
+  lib/driver/util.c
+)
+
+add_library(cdio ${LIBCDIO_SOURCES})
+
+target_include_directories(cdio
+  PRIVATE
+    "${CMAKE_CURRENT_SOURCE_DIR}/.vs"
+    "${CMAKE_CURRENT_SOURCE_DIR}/lib/driver"
+  PUBLIC
+    "$<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/include>"
+    "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>"
+    "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>"
+)
+
+target_compile_definitions(cdio PRIVATE HAVE_CONFIG_H _CRT_SECURE_NO_WARNINGS _CRT_NONSTDC_NO_WARNINGS)
+
+if(MSVC)
+  # Upstream sources expect <windows.h> to come in via the MSVC unistd.h shim
+  target_compile_options(cdio PRIVATE /FIwindows.h)
+endif()
+
+if(MSVC)
+  target_compile_options(cdio PRIVATE /wd4018 /wd4133 /wd4244 /wd4267 /wd4333 /wd4996)
+endif()
+
+target_link_libraries(cdio PRIVATE winmm)
+
+if(BUILD_SHARED_LIBS)
+  set_target_properties(cdio PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
+endif()
+
+install(TARGETS cdio
+  RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}"
+  LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
+  ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}"
+)
+
+file(GLOB LIBCDIO_HEADERS "${CMAKE_CURRENT_SOURCE_DIR}/include/cdio/*.h")
+list(FILTER LIBCDIO_HEADERS EXCLUDE REGEX "/version\.h$")
+install(FILES ${LIBCDIO_HEADERS} "${CMAKE_CURRENT_BINARY_DIR}/include/cdio/version.h"
+  DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/cdio"
+)
+
+set(prefix "${CMAKE_INSTALL_PREFIX}")
+set(exec_prefix "\${prefix}")
+set(libdir "\${prefix}/${CMAKE_INSTALL_LIBDIR}")
+set(includedir "\${prefix}/${CMAKE_INSTALL_INCLUDEDIR}")
+set(PACKAGE_NAME "libcdio")
+set(PACKAGE_VERSION "${PROJECT_VERSION}")
+set(LIBS "-lwinmm")
+set(LTLIBICONV "")
+set(DARWIN_PKG_LIB_HACK "")
+configure_file(libcdio.pc.in "${CMAKE_CURRENT_BINARY_DIR}/libcdio.pc" @ONLY)
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/libcdio.pc" DESTINATION "${CMAKE_INSTALL_LIBDIR}/pkgconfig")
